# Update this manifest file by running the following commands:
# (please sort the lines in this file after running below commands)
#
#  check-manifest -u

include .gitignore
include *.lock
include *.md
include *.rst
include *.sh
include *.toml
exclude .DS_Store
include tests/data/*.marcxml.zip
recursive-include tests *.py
recursive-include tests *.lock
recursive-exclude tests .DS_Store
recursive-exclude tests *.marcxml
recursive-exclude tests *.jsonl
recursive-include invenio_subjects_fast .gitkeep
recursive-include invenio_subjects_fast *.py
recursive-include invenio_subjects_fast *.jsonl
recursive-include invenio_subjects_fast *.yaml
recursive-exclude invenio_subjects_fast .DS_Store
recursive-exclude invenio_subjects_fast *.marcxml
recursive-exclude invenio_subjects_fast *.marcxml.zip
recursive-exclude invenio_subjects_fast *.mrc
recursive-exclude invenio_subjects_fast *.updates.jsonl
